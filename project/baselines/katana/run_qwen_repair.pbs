#!/usr/bin/env bash
# run_qwen_repair.pbs
# Multi-model generality (D17/D23): Qwen2.5-Coder-32B self-repair on HumanEval+.
# Author : Gurdiraj Bal (z5386590)
#
# Continues the Qwen template run after the gate passed and the cop R0 seed was
# graded (Base 0.872 / Plus 0.829, Gap 0.043). Serves Qwen at TP=1 on one H200 and
# runs the self-repair pipeline for BOTH strategies (cot then minimal) against the
# frozen cop R0 seed, matching how Llama's cot/minimal repairs were run. Output:
#   samples/qwen25-coder-32b-instruct_t02_cop_repair-{cot,minimal}_round{1,2}.jsonl
# Grade these with native evalplus (D14) -> Qwen within-model delta (repair - R0),
# compared against Llama's cot/minimal deltas (generality per D17, sign/Gap-shape
# over magnitude given Qwen's high-R0 ceiling).
#
# TP=1 single-GPU (no k201 pin, no k099 TP=2 crash) -> overlaps the Prochemy jobs.
# NOTE: the _repair_run_log.json name omits repair_strategy (D16), so the minimal
# run overwrites the cot run's run-log METADATA - harmless; the per-round JSONLs
# are strategy-named and intact.

#PBS -N qwen_repair
#PBS -l select=1:ncpus=8:ngpus=1:mem=120gb:gpu_model=H200
#PBS -l walltime=02:00:00
#PBS -j oe
#PBS -o qwen_repair.out

set -euo pipefail
cd "${PBS_O_WORKDIR:-$(dirname "$0")}"

module load python/3.11.3
module load cuda/12.5.0

SCRATCH="/srv/scratch/${USER}"
export VENV_PATH="${SCRATCH}/vllm_venv"
export MODEL_PATH="${SCRATCH}/models/Qwen2.5-Coder-32B-Instruct"
export PROJECT_DIR="${PROJECT_DIR:-$HOME/thesis_codegen/COMP4952/project}"
export HF_HUB_OFFLINE=1
export HF_HOME="${SCRATCH}/hf_cache"

export SERVED_NAME="qwen2.5-coder-32b-instruct"
export TENSOR_PARALLEL=1
export MAX_MODEL_LEN=8192

SEED="${PROJECT_DIR}/samples/qwen25-coder-32b-instruct_t02_cop.jsonl"
COMMON="${VENV_PATH}/bin/python generate_samples.py --model ${SERVED_NAME} --backend katana --dataset humaneval --prompt cop --repair --max_repair_rounds 2 --round0_source_jsonl ${SEED}"

# Serve Qwen once (TP=1), then run cot repair, then minimal repair, against the frozen seed.
export RUN_DIR="${PROJECT_DIR}/scripts"
bash "${PROJECT_DIR}/baselines/katana/serve_and_run.sh" \
    bash -c "${COMMON} --repair_strategy cot && ${COMMON} --repair_strategy minimal"
