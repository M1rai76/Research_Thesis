#!/usr/bin/env bash
# run_deepseek_smoke.pbs
# Multi-model generality (D17/D23): DeepSeek-Coder-33B-Instruct seed run on HumanEval+.
# Author : Gurdiraj Bal (z5386590)
#
# GATE checkpoint for the third generality model, following the Qwen precedent
# exactly. Serves DeepSeek at TP=1 on a single H200 and generates the HumanEval+
# `cop` seed. The one real integration risk is post_process() handling DeepSeek's
# output formatting (HumanEval wants a bare, indented function body - no `def`,
# no markdown fences); inspect the resulting JSONL by hand before committing to
# the cot/minimal repair run.
#     qsub run_deepseek_smoke.pbs
#
# NOTE ON --limit: it is accepted by argparse but NON-FUNCTIONAL in the merged
# generation path (a known bug, observed on the Qwen smoke 2026-07-21), so this
# job generates all 164 tasks regardless. That is deliberate here - it costs only
# a few extra minutes of GPU and yields a complete, reusable `cop` seed rather
# than a partial file that a later --resume-missing would have to top up.
#
# WHY TP=1 / no k201 pin: a 33B bf16 model (~66GB) fits one >=80GB GPU, so single-
# GPU serving needs no tensor-parallel -> it cannot hit the k099 TP=2 symm-mem
# crash (D22) and runs on ANY H200. gpu_model=H200 guarantees a big-enough GPU
# (not a 48GB L40S / 32GB V100).

#PBS -N deepseek_smoke
#PBS -l select=1:ncpus=8:ngpus=1:mem=120gb:gpu_model=H200
#PBS -l walltime=02:00:00
#PBS -j oe
#PBS -o deepseek_smoke.out

set -euo pipefail
cd "${PBS_O_WORKDIR:-$(dirname "$0")}"

# --- Katana environment (verified module names) ------------------------------
module load python/3.11.3
module load cuda/12.5.0

# --- Paths -------------------------------------------------------------------
SCRATCH="/srv/scratch/${USER}"
export VENV_PATH="${SCRATCH}/vllm_venv"          # shared vLLM venv (has evalplus + openai)
export MODEL_PATH="${SCRATCH}/models/deepseek-coder-33b-instruct"
export PROJECT_DIR="${PROJECT_DIR:-$HOME/thesis_codegen/COMP4952/project}"

# Weights are pre-staged, so keep HF fully offline on the compute node.
export HF_HUB_OFFLINE=1
export HF_HOME="${SCRATCH}/hf_cache"

# --- Serving config: single-GPU, TP=1 ----------------------------------------
# SERVED_NAME drives model_to_slug -> deepseek-coder-33b-instruct (namespaced
# from both Llama and Qwen outputs).
export SERVED_NAME="deepseek-coder-33b-instruct"
export TENSOR_PARALLEL=1                          # = ngpus above
export MAX_MODEL_LEN=8192

# --- Run: shared serve_and_run.sh serves vLLM, then the cop seed generation ---
export RUN_DIR="${PROJECT_DIR}/scripts"
bash "${PROJECT_DIR}/baselines/katana/serve_and_run.sh" \
    python generate_samples.py \
        --model "${SERVED_NAME}" \
        --backend katana \
        --dataset humaneval \
        --prompt cop
