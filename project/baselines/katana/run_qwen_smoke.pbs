#!/usr/bin/env bash
# run_qwen_smoke.pbs
# Multi-model generality (D17/D23): Qwen2.5-Coder-32B-Instruct smoke test on HumanEval+.
# Author : Gurdiraj Bal (z5386590)
#
# This is the GATE checkpoint for the timeboxed Qwen integration (D23). It serves
# Qwen at TP=1 on a single H200 and generates 5 HumanEval+ `cop` samples, purely
# to check that post_process() handles Qwen's output formatting cleanly (a bare,
# indented function body - no `def`, no fences). Inspect the resulting JSONL by
# hand before committing to the full cop-seed -> cot/minimal repair template run.
#     qsub run_qwen_smoke.pbs
#
# WHY TP=1 / no k201 pin: a 32B bf16 model (~64GB) fits one >=80GB GPU, so single-
# GPU serving needs no tensor-parallel -> it can't hit the k099 TP=2 symm-mem crash
# (D22) and runs on ANY H200, overlapping the k201-pinned Prochemy jobs at zero
# contention. gpu_model=H200 guarantees a big-enough GPU (not a 48GB L40S / 32GB V100).
#
# NOTE: writes a PARTIAL samples/qwen25-coder-32b-instruct_t02_cop.jsonl (5 tasks).
# Delete it before any full run, or a later --resume-missing will fill the rest.

#PBS -N qwen_smoke
#PBS -l select=1:ncpus=8:ngpus=1:mem=120gb:gpu_model=H200
#PBS -l walltime=01:00:00
#PBS -j oe
#PBS -o qwen_smoke.out

set -euo pipefail
cd "${PBS_O_WORKDIR:-$(dirname "$0")}"

# --- Katana environment (verified module names) ------------------------------
module load python/3.11.3
module load cuda/12.5.0

# --- Paths -------------------------------------------------------------------
SCRATCH="/srv/scratch/${USER}"
export VENV_PATH="${SCRATCH}/vllm_venv"          # shared vLLM venv (has evalplus + openai)
export MODEL_PATH="${SCRATCH}/models/Qwen2.5-Coder-32B-Instruct"
export PROJECT_DIR="${PROJECT_DIR:-$HOME/thesis_codegen/COMP4952/project}"

# Weights are pre-staged, so keep HF fully offline on the compute node.
export HF_HUB_OFFLINE=1
export HF_HOME="${SCRATCH}/hf_cache"

# --- Serving config: single-GPU, TP=1 (the whole point - no k201 pin) ---------
# SERVED_NAME drives model_to_slug -> qwen25-coder-32b-instruct (namespaced from Llama).
export SERVED_NAME="qwen2.5-coder-32b-instruct"
export TENSOR_PARALLEL=1                          # = ngpus above
export MAX_MODEL_LEN=8192

# --- Run: shared serve_and_run.sh serves vLLM, then a 5-task cop smoke test ----
export RUN_DIR="${PROJECT_DIR}/scripts"
bash "${PROJECT_DIR}/baselines/katana/serve_and_run.sh" \
    python generate_samples.py \
        --model "${SERVED_NAME}" \
        --backend katana \
        --dataset humaneval \
        --prompt cop \
        --limit 5
